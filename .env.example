# Copy to .env and edit. Credentials stay out of source code.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=product_reco
# auto  = use MongoDB if reachable, otherwise fall back to in-memory mongomock
# true  = always use in-memory mongomock
# false = require a real MongoDB server (fail if unreachable)
USE_MOCK_DB=auto
